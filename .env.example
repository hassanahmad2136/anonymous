# ============================================================
#  False MLBB Overlay Tool - Environment Variables
#  Copy this file to .env and fill in your values
# ============================================================

# ----- OVERLAY SERVER (port 3000) -----
PORT=3000

# ----- DRAFT / ADMIN SERVER (port 3001) -----
DRAFT_PORT=3001

# URL the draft server uses to reach the overlay server
# Locally: http://localhost:3000
# Hosted:  https://your-overlay-service.railway.app
OVERLAY_URL=http://localhost:3000

# Draft timer duration in seconds
TIMER_DURATION=60

# ----- NGROK (optional, for remote captain links) -----
# Leave blank to use local links only
NGROK_URL=

# ----- TOURNAMENT BRANDING -----
TOURNAMENT_NAME=Battle of Souls
TOURNAMENT_TAGLINE=Where Legends Rise
ORGANIZER=Shapitos Gaming
